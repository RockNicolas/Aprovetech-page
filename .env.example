# E-mails mostrados no site como contato (separados por vírgula)
NEXT_PUBLIC_CONTACT_EMAIL=contato@nidconsultoria.com.br,rocksoftwaresolutions.dev@gmail.com

# Envio dos pedidos de demonstração pelo Resend. SMTP_PASS é a chave de API (re_...).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Remetente: um endereço do domínio verificado no Resend
SMTP_FROM="AproveTech <nao-responda@aprovetech.com>"
# Opcional: quem recebe os pedidos. Vazio usa os e-mails de contato acima.
DEMO_EMAIL_TO=

# Endereço público do site, sem barra no fim. Troque pelo domínio real ao publicar.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Código de verificação do Google Search Console (opcional; deixe vazio se não usar)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
